 "song_format": {
  "section": "song_format",
  "schema": {
   "$defs": {
    "DelayConfig": {
     "description": "Delay engine parameters.",
     "properties": {
      "time": {
       "anyOf": [
        {
         "maximum": 127,
         "minimum": 0,
         "type": "integer"
        },
        {
         "type": "null"
        }
       ],
       "default": null,
       "title": "Time"
      },
      "sync": {
       "anyOf": [
        {
         "maximum": 35,
         "minimum": 0,
         "type": "integer"
        },
        {
         "type": "null"
        }
       ],
